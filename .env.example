# ============================================================================
# Brand Pulse - plantilla de configuracion. Copiar a .env y ajustar.
#   cp .env.example .env
# NO subir el archivo .env real al repositorio.
# ============================================================================

# --- Aplicacion ---
APP_NAME="Brand Pulse API"
APP_ENV=development
DEBUG=true
API_VERSION=0.1.0

# --- Servidor ---
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

# --- CORS (frontend Vite en desarrollo) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Base de datos (SQLite local) ---
DATABASE_URL=sqlite:///backend/data/brand_pulse.db
DATABASE_ECHO=false

# --- Modelo de deteccion ---
MODEL_PATH=models/football_brands/best.pt
MODEL_PRELOAD=true
MODEL_CONFIDENCE_THRESHOLD=0.25
MODEL_IOU_THRESHOLD=0.45
DEVICE=cpu
# Las clases se leen directamente del modelo: Adidas, Emirates, Nike, Spotify.

# --- Procesamiento de video ---
VIDEO_FPS_SAMPLING=2
VIDEO_MAX_DURATION_SECONDS=1800
VIDEO_MAX_UPLOAD_MB=2048

# --- Almacenamiento local ---
UPLOAD_DIR=backend/storage/uploads
OUTPUT_DIR=backend/storage/outputs
